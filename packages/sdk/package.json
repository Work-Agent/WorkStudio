{
  "name": "@workstudio/sdk",
  "version": "0.1.0",
  "description": "WorkStudio plugin SDK: engine, page and manifest contracts",
  "keywords": [
    "workstudio",
    "plugin",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "workstudio-plugin": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
