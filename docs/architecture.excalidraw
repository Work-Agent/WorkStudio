      "link": null,
      "locked": false,
      "text": "interface DomainManager {        // 框架实现\n  register(pluginId, c): Disposable;\n  revoke(pluginId): void;\n  resolve(addr): Target | null;\n  dispatchCommand(call): Promise<CallResult>;\n  changed(ref, kind): void;\n}\n\ninterface PluginContext {        // 插件可见的全部\n  fs · settings · changed · log\n}\n// 没有绝对路径 · 没有 ipcMain · 没有窗口",
      "originalText": "interface DomainManager {        // 框架实现\n  register(pluginId, c): Disposable;\n  revoke(pluginId): void;\n  resolve(addr): Target | null;\n  dispatchCommand(call): Promise<CallResult>;\n  changed(ref, kind): void;\n}\n\ninterface PluginContext {        // 插件可见的全部\n  fs · settings · changed · log\n}\n// 没有绝对路径 · 没有 ipcMain · 没有窗口",
