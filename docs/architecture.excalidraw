      "boundElements": [],
      "updated": 1735000000000,
      "link": null,
      "locked": false,
      "text": "// docx.read 的一条\n{ \"locator\": \"docx:para:12\",\n  \"text\": \"3.2 收入确认\", \"style\": \"Heading2\" }\n\n// xlsx.grep 的一条\n{ \"locator\": \"xlsx:cell:Q1!B2\",\n  \"rows\": [[\"华东\", 1280]], \"sheet\": \"Q1\" }\n\n// 字段由插件定；框架只限条数、透传 locator、记录 ref",
      "originalText": "// docx.read 的一条\n{ \"locator\": \"docx:para:12\",\n  \"text\": \"3.2 收入确认\", \"style\": \"Heading2\" }\n\n// xlsx.grep 的一条\n{ \"locator\": \"xlsx:cell:Q1!B2\",\n  \"rows\": [[\"华东\", 1280]], \"sheet\": \"Q1\" }\n\n// 字段由插件定；框架只限条数、透传 locator、记录 ref",
      "fontSize": 14,
