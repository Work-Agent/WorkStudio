    {
      "id": "b8-plugin-c",
      "type": "text",
      "x": 874,
      "y": 2810,
      "width": 752,
      "height": 405.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.6,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 41839275,
      "version": 1,
      "versionNonce": 725805843,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735000000000,
      "link": null,
      "locked": false,
      "text": "// dist/engine.js —— exports[\"./workstudio\"] 指向它\nexport const workstudio = definePlugin({\n  resources: {\n    docx: {\n      read: async (ref) => [{ locator: 'docx:para:12',\n                              text: '3.2 收入确认' }],\n      grep: async (ref, q) => [{ locator: 'docx:para:12',\n                                 snippet: '…收入确认…' }],\n    },\n  },\n  commands: {\n    'docx.insert': {\n      summary: '在指定段落插入文本',\n      args: { at: locator('docx:para'),\n              text: { type: 'string', required: true } },\n      run: async ({ ref, at, text }, ctx) => {\n        await insert(ref, at, text);\n        ctx.changed(ref, 'content');\n        return { changed: at };\n      },\n    },\n  },\n  lifecycle: { activate, deactivate },\n});",
      "originalText": "// dist/engine.js —— exports[\"./workstudio\"] 指向它\nexport const workstudio = definePlugin({\n  resources: {\n    docx: {\n      read: async (ref) => [{ locator: 'docx:para:12',\n                              text: '3.2 收入确认' }],\n      grep: async (ref, q) => [{ locator: 'docx:para:12',\n                                 snippet: '…收入确认…' }],\n    },\n  },\n  commands: {\n    'docx.insert': {\n      summary: '在指定段落插入文本',\n      args: { at: locator('docx:para'),\n              text: { type: 'string', required: true } },\n      run: async ({ ref, at, text }, ctx) => {\n        await insert(ref, at, text);\n        ctx.changed(ref, 'content');\n        return { changed: at };\n      },\n    },\n  },\n  lifecycle: { activate, deactivate },\n});",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "baseline": 12,
