      "text": "⑤ 数据层接口：ls · find · read · grep",
      "originalText": "⑤ 数据层接口：ls · find · read · grep",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
