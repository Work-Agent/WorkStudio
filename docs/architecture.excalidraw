      "updated": 1735000000000,
      "link": null,
      "locked": false,
      "text": "{\n  \"name\": \"@workstudio-plugins/docx\",\n  \"version\": \"1.4.0\",\n  \"type\": \"module\",\n  \"exports\": { \"./workstudio\": \"./dist/engine.js\" },\n  \"workstudio\": {\n    \"apiVersion\": 2,\n    \"id\": \"docx\",\n    \"label\": \"Word 文档\",\n    \"icon\": \"file-text\",\n    \"claims\": [{ \"extensions\": [\"docx\"], \"priority\": 10 }],\n    \"domain\": \"docx\",\n    \"commands\": \"dist/commands.json\",\n    \"pages\": { \"content\": \"dist/page/index.html\" },\n    \"settings\": { \"schema\": \"dist/settings.schema.json\" },\n    \"skills\": [{ \"name\": \"docx\", \"dir\": \"skills/docx\" }],\n    \"permissions\": { \"fs\": [\"${workspace}/**\"] },\n    \"activation\": [\"onClaim\", \"onCommand:docx/*\"]\n  }\n}",
      "originalText": "{\n  \"name\": \"@workstudio-plugins/docx\",\n  \"version\": \"1.4.0\",\n  \"type\": \"module\",\n  \"exports\": { \"./workstudio\": \"./dist/engine.js\" },\n  \"workstudio\": {\n    \"apiVersion\": 2,\n    \"id\": \"docx\",\n    \"label\": \"Word 文档\",\n    \"icon\": \"file-text\",\n    \"claims\": [{ \"extensions\": [\"docx\"], \"priority\": 10 }],\n    \"domain\": \"docx\",\n    \"commands\": \"dist/commands.json\",\n    \"pages\": { \"content\": \"dist/page/index.html\" },\n    \"settings\": { \"schema\": \"dist/settings.schema.json\" },\n    \"skills\": [{ \"name\": \"docx\", \"dir\": \"skills/docx\" }],\n    \"permissions\": { \"fs\": [\"${workspace}/**\"] },\n    \"activation\": [\"onClaim\", \"onCommand:docx/*\"]\n  }\n}",
