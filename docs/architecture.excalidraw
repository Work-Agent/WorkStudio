    {
      "id": "b8-paths-c",
      "type": "text",
      "x": 54,
      "y": 3310,
      "width": 1152,
      "height": 163.79999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.6,
      "strokeStyle": "solid",
      "roughness": 0,
