      "seed": 1672884256,
      "version": 1,
      "versionNonce": 389878645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735000000000,
      "link": null,
      "locked": false,
      "text": "// 业务 UI · 类型化 op\nawait invoke('docx', '销售/2026Q1.docx', 'insert', {\n  at: 'docx:para:12', text: '补充说明',\n});\n// → { ok: true, data: { changed: 'docx:para:12' } }\n\n# 助手 · bash（同一份 run，argv 由框架 CLI 解析）\nws docx insert 销售/2026Q1.docx --at docx:para:12 --text \"补充说明\"\n# → exit 0　　# 目标不存在 → not_found，exit 3",
      "originalText": "// 业务 UI · 类型化 op\nawait invoke('docx', '销售/2026Q1.docx', 'insert', {\n  at: 'docx:para:12', text: '补充说明',\n});\n// → { ok: true, data: { changed: 'docx:para:12' } }\n\n# 助手 · bash（同一份 run，argv 由框架 CLI 解析）\nws docx insert 销售/2026Q1.docx --at docx:para:12 --text \"补充说明\"\n# → exit 0　　# 目标不存在 → not_found，exit 3",
