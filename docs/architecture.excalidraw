      "text": "const page = createPage<DocxApi>({ plugin: 'docx' });\n\npage.resource.watch((s) => render(s.text));\nawait page.resource.save(bytes);   // 写入 → 变更通知回推\npage.settings.watch((s) => apply(s));\npage.call('docx.insert', { at, text });  // 类型 + 校验",
      "originalText": "const page = createPage<DocxApi>({ plugin: 'docx' });\n\npage.resource.watch((s) => render(s.text));\nawait page.resource.save(bytes);   // 写入 → 变更通知回推\npage.settings.watch((s) => apply(s));\npage.call('docx.insert', { at, text });  // 类型 + 校验",
