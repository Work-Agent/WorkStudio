    },
    {
      "id": "b8-sig-c",
      "type": "text",
      "x": 1254,
      "y": 3310,
      "width": 1132,
      "height": 200.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.6,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 906783938,
      "version": 1,
      "versionNonce": 1824475966,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735000000000,
      "link": null,
      "locked": false,
      "text": "type Item  = { locator: string } & Record<string, unknown>;\ntype Entry = { name: string; type: string; ref: string };\n\ninterface ResourceAdapter {\n  ls(ref, opts?): Promise<Entry[]>;\n  find(ref, query): Promise<Entry[]>;\n  read(ref, opts?): Promise<Item[]>;\n  grep(ref, query): Promise<Item[]>;\n}\n\n// locator 只在 read / grep 的结果里",
      "originalText": "type Item  = { locator: string } & Record<string, unknown>;\ntype Entry = { name: string; type: string; ref: string };\n\ninterface ResourceAdapter {\n  ls(ref, opts?): Promise<Entry[]>;\n  find(ref, query): Promise<Entry[]>;\n  read(ref, opts?): Promise<Item[]>;\n  grep(ref, query): Promise<Item[]>;\n}\n\n// locator 只在 read / grep 的结果里",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "baseline": 13,
      "autoResize": true
    },
