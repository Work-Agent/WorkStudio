      "link": null,
      "locked": false,
      "text": "interface DomainManager {          // 框架实现\n  register(pluginId, contribution): Disposable;\n  revoke(pluginId): void;\n  resolve(addr): Target | null;\n  dispatchCommand(call): Promise<CallResult>;\n  subscribe(viewId, addr): unknown;\n  invalidate(ref): void;\n}\n\ninterface PluginContext {        // 插件可见的全部能力\n  fs: { read(ref): Promise<Uint8Array>;\n        write(ref, bytes): Promise<Revision> };\n  settings: { get<T>(): T; watch(cb): Disposable };\n  index: { put(ref, facts): void;\n           get(ref): Facts | null };\n  invalidate(ref: string): void;\n  log: { info; warn; error };\n}\n\n// 没有绝对路径 · 没有 ipcMain · 没有窗口",
      "originalText": "interface DomainManager {          // 框架实现\n  register(pluginId, contribution): Disposable;\n  revoke(pluginId): void;\n  resolve(addr): Target | null;\n  dispatchCommand(call): Promise<CallResult>;\n  subscribe(viewId, addr): unknown;\n  invalidate(ref): void;\n}\n\ninterface PluginContext {        // 插件可见的全部能力\n  fs: { read(ref): Promise<Uint8Array>;\n        write(ref, bytes): Promise<Revision> };\n  settings: { get<T>(): T; watch(cb): Disposable };\n  index: { put(ref, facts): void;\n           get(ref): Facts | null };\n  invalidate(ref: string): void;\n  log: { info; warn; error };\n}\n\n// 没有绝对路径 · 没有 ipcMain · 没有窗口",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
