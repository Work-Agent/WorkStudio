      "text": "{\n  \"docx.insert\": {\n    \"address\": \"docx/<ref>/insert\",\n    \"argv\": [\"insert\", \"<ref>\", \"--at\", \"--text\", \"--position\"],\n    \"exitCodes\": {\n      \"0\": \"ok\", \"1\": \"failed\", \"2\": \"usage\", \"4\": \"stale\"\n    },\n    \"output\": { \"revision\": \"string\" }\n  }\n}",
