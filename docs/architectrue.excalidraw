      "text": "import { createPage } from '@workstudio/sdk/page';\nconst page = createPage({ plugin: 'docx' });\n\npage.resource.watch((s) => render(s.text, s.revision));\nawait page.resource.save(bytes);   // 冲突 → conflict\npage.ui.dialog({ dialogType: 'confirm', title: '放弃修改？' });",
