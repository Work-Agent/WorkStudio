      "text": "import { definePlugin, locator } from '@workstudio/sdk';\n\nexport default definePlugin({\n  id: 'docx',\n  resources: [{\n    scheme: 'docx',\n    mount: async (ref) => ({ blocks: await parse(ref) }),\n    read: (ref) => pageOf(ref),\n    grep: (ref, q) => hits(ref, q),        // 带 locator\n  }],\n  commands: {\n    'docx.insert': {\n      summary: '在指定段落插入文本',\n      args: {\n        at: locator('docx:para'),          // 失效 → stale\n        text: { type: 'string', required: true },\n        position: { enum: ['before', 'after'], default: 'after' },\n      },\n      run: async ({ at, text, position }, ctx) => {\n        await ctx.edit(at, (p) => insert(p, text, position));\n        return { revision: ctx.revision };  // → 新 locator\n      },\n    },\n  },\n});",
      "originalText": "import { definePlugin, locator } from '@workstudio/sdk';\n\nexport default definePlugin({\n  id: 'docx',\n  resources: [{\n    scheme: 'docx',\n    mount: async (ref) => ({ blocks: await parse(ref) }),\n    read: (ref) => pageOf(ref),\n    grep: (ref, q) => hits(ref, q),        // 带 locator\n  }],\n  commands: {\n    'docx.insert': {\n      summary: '在指定段落插入文本',\n      args: {\n        at: locator('docx:para'),          // 失效 → stale\n        text: { type: 'string', required: true },\n        position: { enum: ['before', 'after'], default: 'after' },\n      },\n      run: async ({ at, text, position }, ctx) => {\n        await ctx.edit(at, (p) => insert(p, text, position));\n        return { revision: ctx.revision };  // → 新 locator\n      },\n    },\n  },\n});",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "baseline": 13,
