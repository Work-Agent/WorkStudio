{
  "name": "work-studio",
  "productName": "WorkStudio",
  "version": "0.3.2",
  "private": true,
  "description": "WorkStudio desktop application",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "qingo",
    "email": "97383102@qq.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "predev": "pnpm sdk:build",
    "dev": "electron-vite dev",
    "prebuild": "pnpm sdk:build",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder --dir",
    "make": "pnpm build && electron-builder",
    "release": "pnpm build && electron-builder --publish always",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm sdk:typecheck && pnpm lint && pnpm sdk:build && pnpm build",
    "test:e2e": "playwright test",
    "test:e2e:full": "pnpm build && playwright test",
    "test:e2e:last": "playwright test --last-failed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cdp": "node --experimental-strip-types e2e/runner/cli.ts",
    "test:e2e:dev": "pnpm build && E2E_DEV=1 playwright test",
    "test:e2e:dev:last": "pnpm build && E2E_DEV=1 playwright test --last-failed",
    "test:e2e:dev:ui": "pnpm build && E2E_DEV=1 playwright test --ui",
    "test:e2e:dev:run": "E2E_DEV=1 playwright test",
    "test:e2e:dev:full": "pnpm build && E2E_DEV=1 playwright test",
    "postinstall": "install-electron",
    "sdk:build": "pnpm --filter @work-studio/sdk build",
    "sdk:typecheck": "pnpm --filter @work-studio/sdk typecheck",
    "test:e2e:real": "pnpm build && playwright test --config playwright.real.config.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@floating-ui/react": "^0.27.20",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@work-studio/sdk": "workspace:*",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.8",
    "lucide-react": "^1.53.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typebox": "^1.3.27",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "type": "module",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "undici": "^8.12.3"
  }
}
