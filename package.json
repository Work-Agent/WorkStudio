{
  "name": "work-studio",
  "productName": "WorkStudio",
  "version": "0.1.0",
  "private": true,
  "description": "WorkStudio desktop application",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "qingo",
    "email": "97383102@qq.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder --dir",
    "make": "pnpm build && electron-builder",
    "release": "pnpm build && electron-builder --publish always",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm build",
    "test:e2e": "playwright test",
    "test:e2e:full": "pnpm build && playwright test",
    "test:e2e:last": "playwright test --last-failed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cdp": "node --experimental-strip-types e2e/runner/cli.ts",
    "test:e2e:dev": "pnpm build && E2E_DEV=1 playwright test",
    "test:e2e:dev:last": "pnpm build && E2E_DEV=1 playwright test --last-failed",
    "test:e2e:dev:ui": "pnpm build && E2E_DEV=1 playwright test --ui",
    "test:e2e:dev:run": "E2E_DEV=1 playwright test",
    "test:e2e:dev:full": "pnpm build && E2E_DEV=1 playwright test",
    "paths:smoke": "node --experimental-strip-types scripts/paths-smoke.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@floating-ui/react": "^0.27.20",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "^1.66.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "type": "module",
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
