{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@work-studio/sdk": ["./packages/sdk/src/index.ts"],
      "@work-studio/sdk/*": ["./packages/sdk/src/*"]
    }
  },
  "include": ["src/**/*", "e2e/**/*", "*.ts", "*.mts"]
}
